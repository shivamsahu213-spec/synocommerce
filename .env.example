# SynoCommerce Environment Configuration Template

# Platform
NODE_ENV=development
PORT=3000
SECRET_KEY=syno_enterprise_jwt_secret_key_2026

# Object Storage Credentials
AWS_S3_BUCKET=syno-media-bucket
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=s3_access_key_placeholder
AWS_S3_SECRET_ACCESS_KEY=s3_secret_key_placeholder

CLOUDFLARE_R2_ACCOUNT_ID=cf_account_id_placeholder
CLOUDFLARE_R2_ACCESS_KEY_ID=cf_r2_access_key_placeholder
CLOUDFLARE_R2_SECRET_ACCESS_KEY=cf_r2_secret_key_placeholder

CLOUDINARY_CLOUD_NAME=synocommerce
CLOUDINARY_API_KEY=cloudinary_api_key_placeholder
CLOUDINARY_API_SECRET=cloudinary_api_secret_placeholder

GCS_BUCKET=syno-gcs-bucket
GCS_CLIENT_EMAIL=gcs_client_email_placeholder
GCS_PRIVATE_KEY=gcs_private_key_placeholder

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=synostorage;AccountKey=azure_key_placeholder;EndpointSuffix=core.windows.net
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# CDN Credentials
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
CLOUDFLARE_ZONE_ID=cf_zone_id_placeholder
CLOUDFLARE_API_TOKEN=cf_api_token_placeholder
FASTLY_SERVICE_ID=fastly_service_id_placeholder
FASTLY_API_KEY=fastly_api_key_placeholder

# Database & Redis
DATABASE_URL=postgresql://syno_admin:syno_password@localhost:5432/synocommerce
REDIS_URL=redis://localhost:6379
