# ==========================================
# SynoCommerce Global Environment Configuration
# ==========================================

# Server & Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SYNO_SECRET_KEY=syno_super_secret_enterprise_jwt_key_2026

# Application Service Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3002

# PostgreSQL Database Configuration
DATABASE_URL="<Neon pooled connection string>"
DIRECT_URL="<Neon direct connection string>"
POSTGRES_USER="<your_db_user>"
POSTGRES_PASSWORD="<your_db_password>"
POSTGRES_DB="<your_db_name>"
POSTGRES_PORT=5432
DB_POOL_MAX=20

# JWT Secrets and Expirations
JWT_ACCESS_SECRET="<your_access_secret>"
JWT_REFRESH_SECRET="<your_refresh_secret>"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Meilisearch Engine
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=syno_meili_master_key_2026

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=synocommerce-assets

# Telemetry & Observability
OTEL_SERVICE_NAME=synocommerce-api
PROMETHEUS_METRICS_ENABLED=true
